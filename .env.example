# Para desarrollo local, copia este archivo en el entorno local como `.env.local` y completa los datos

# Flag unica de modo demo para todos los servicios
# true  -> Utiliza data/demo/ directamente, sin ninguna peticion de red
# false -> Consume las APIs; si falla no utiliza mocks
# Para usar datos de demo de un solo servicio, deja su VITE_*_API_URL vacía con esta flag en false
VITE_USE_DEMO_MOCKS=false

# URL base de la API pública de eventos
# Ejemplo local: http://localhost:8080/api/public
# Ejemplo AWS: https://na279sqez3.execute-api.us-east-1.amazonaws.com/api/public
VITE_EVENTS_API_URL=
# URL base HTTPS del microservicio de instituciones, sedes y equipos
VITE_INSTITUTIONS_API_URL=
# URL base del microservicio de competencias y resultados
VITE_COMPETITIONS_API_URL=
# URL base de microservicio de ranking
VITE_RANKING_API_URL=
# URL base del servicio de suscripciones
VITE_NOTIFICATIONS_API_URL=
# Site key publica de Cloudflare Turnstile. La de este example es la clave de prueba que siempre pasa
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Autenticacion de usuarios (AWS Cognito). Sin estos valores el acceso corre en modo
# simulado, solo en desarrollo: no crea cuentas reales (codigo de verificacion 123456)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Fuerza el acceso simulado tambien en un build de produccion (solo para demos)
VITE_AUTH_DEMO=
