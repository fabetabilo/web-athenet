# URL base de la API pública de eventos
VITE_EVENTS_API_URL=http://localhost:8080/api/public
# URL base HTTPS del microservicio de instituciones, sedes y equipos
VITE_INSTITUTIONS_API_URL=https://na279sqez3.execute-api.us-east-1.amazonaws.com/api/v1
# URL base del microservicio de competencias y resultados
# NOTA: Sin definir -> MatchStrip usa el mock de src/data/demo/competitionMatches.js
VITE_COMPETITIONS_API_URL=

# Flags para forzar mocks locales sin intentar peticiones de red
# true  -> Utiliza src/data/demo/ directamente
# false -> Consume la API (con fallback automático ante fallos de red)
VITE_USE_EVENT_MOCKS=false
VITE_USE_INSTITUTION_MOCKS=false
VITE_USE_COMPETITION_MOCKS=false
