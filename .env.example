# URL base de la API pública de eventos
VITE_EVENTS_API_URL=http://localhost:8080/api/public

# Flag para forzar mocks locales sin intentar peticiones de red
# true  -> Utiliza src/data/ directamente
# false -> Consume la API de ms-events (con fallback automático ante fallos de red)
VITE_USE_EVENT_MOCKS=false
